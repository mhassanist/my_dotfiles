#!/usr/bin/env bash
# ai-setup: my AI dev setup, from one folder (~/.ai-msaudi).
#
#   ai-setup link [--check] [--quiet]
#       Points every installed agent's global guide at ~/.ai-msaudi/AGENTS.md.
#       Runs on its own (no questions) so the pre-push hook can call it.
#
#   ai-setup [--check | --yes] [path]
#       Sets up and checks a code repo (default: the current folder):
#       memory (AGENTS.md Memory section, CLAUDE.md import, memory/*.md), lefthook hooks
#       (gitleaks, analyze, tests, AI review reminder), .gitleaks.toml, analysis_options.yaml
#       (Flutter), tools from tools.conf (warn only), and the agent guide links.
#       Asks y/N before each change; --check only reports; --yes applies everything.
#
# Never deletes: anything replaced is kept as <file>.bak-<time> (unless git can restore it).
set -uo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d=$(cd -P "$(dirname "$src")" && pwd); src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
ROOT=$(cd -P "$(dirname "$src")/.." && pwd)        # ~/.ai-msaudi
GUIDE="$ROOT/AGENTS.md"
TPL="$ROOT/templates"
TOOLS="$ROOT/tools.conf"

# Every known agent's global guide file. Add a line to support another agent.
# The first one is always created; the others only where the agent is installed.
AGENT_FILES="$HOME/.agents/AGENTS.md
$HOME/.claude/CLAUDE.md
$HOME/.claude-blink/CLAUDE.md
$HOME/.codex/AGENTS.md
$HOME/.gemini/GEMINI.md
$HOME/.config/opencode/AGENTS.md"

# ── output and prompts ────────────────────────────────────────────────────────
fail=0; QUIET=0
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$1"; fail=1; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$1"; }
ok()   { [ "$QUIET" -eq 1 ] || printf '✓ %s\n' "$1"; }
note() { printf '    %s\n' "$1"; }
ask() {  # ask "question" → 0 = go ahead
  case "$MODE" in check) return 1 ;; yes) return 0 ;; esac
  local a; printf '    → %s? [y/N] ' "$1"; read -r a < /dev/tty || a=""
  case "$a" in [Yy]*) return 0 ;; *) return 1 ;; esac
}
ask_value() {  # ask_value "question" "default"
  local a; [ "$MODE" = yes ] && { printf '%s' "$2"; return; }
  printf '    → %s [%s]: ' "$1" "$2" > /dev/tty; read -r a < /dev/tty || a=""; printf '%s' "${a:-$2}"
}
# fix "problem" "question" cmd...: ✗ unless the fix is applied
fix() {
  local problem="$1" q="$2"; shift 2
  if ask "$problem. $q"; then
    if "$@"; then printf '\033[1;32m✓ fixed: %s\033[0m\n' "$problem"; return 0; fi
    err "$problem (fix failed)"; return 1
  fi
  err "$problem"
}
tilde() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }
bakname() {
  local b i=1; b="$1.bak-$(date +%Y%m%d%H%M%S)"
  while [ -e "$b" ] || [ -L "$b" ]; do b="$1.bak-$(date +%Y%m%d%H%M%S)-$i"; i=$((i+1)); done
  printf '%s' "$b"
}
backup() {  # copy a file aside unless git can restore it
  [ -f "$1" ] || return 0
  if git ls-files --error-unmatch -- "$1" >/dev/null 2>&1 && git diff --quiet -- "$1" 2>/dev/null; then return 0; fi
  local b; b=$(bakname "$1"); cp -p "$1" "$b" && note "backed up $1 to $b"
}

# ── link: agent guides ────────────────────────────────────────────────────────
link_guides() {  # link_guides check|fix
  local f first=1 b
  [ -f "$GUIDE" ] || { err "no $GUIDE"; return; }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -L "$f" ] && [ "$(readlink "$f")" = "$GUIDE" ]; then
      ok "$(tilde "$f") → $(tilde "$GUIDE")"
    elif [ "$first" -eq 0 ] && [ ! -d "$(dirname "$f")" ]; then
      :  # agent not installed here
    elif [ "$1" = check ]; then
      warn "$(tilde "$f") doesn't point to $(tilde "$GUIDE") (run: ai-setup link)"
    else
      mkdir -p "$(dirname "$f")"
      if [ -e "$f" ] || [ -L "$f" ]; then b=$(bakname "$f"); mv -n "$f" "$b" || { err "can't move $f aside"; first=0; continue; }; fi
      if ln -s "$GUIDE" "$f"; then
        printf '\033[1;32m✓ linked %s → '"$(tilde "$GUIDE")"'\033[0m%s\n' "$(tilde "$f")" "${b:+ (old one kept as $(tilde "$b"))}"
      else err "can't link $f"; fi
      b=""
    fi
    first=0
  done <<< "$AGENT_FILES"
}

MODE=ask; TARGET=""; CMD=repo
for arg in "$@"; do
  case "$arg" in
    link) CMD=link ;;
    --check) MODE=check ;;
    --yes|-y) MODE=yes ;;
    --quiet|-q) QUIET=1 ;;
    -h|--help) sed -n '2,16p' "$src"; exit 0 ;;
    -*) echo "Unknown option: $arg" >&2; exit 2 ;;
    *) TARGET="$arg" ;;
  esac
done

if [ "$CMD" = link ]; then
  [ "$QUIET" -eq 1 ] || echo "── Agent guide links"
  if [ "$MODE" = check ]; then link_guides check; else link_guides fix; fi
  exit "$fail"
fi
if [ "$MODE" = ask ] && ! { [ -t 0 ] && [ -t 1 ]; }; then MODE=check; fi

# ── repo ──────────────────────────────────────────────────────────────────────
[ -n "$TARGET" ] && { cd "$TARGET" 2>/dev/null || { echo "Not a folder: $TARGET" >&2; exit 2; }; }
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not inside a git repo: ${TARGET:-$PWD}" >&2; exit 2; }
cd "$root" || exit 2
printf 'Checking %s\n' "$root"
flutter=0; [ -f pubspec.yaml ] && flutter=1

echo; echo "── Memory"
mk_agents()  { cp "$TPL/AGENTS.md" AGENTS.md && note "fill in the project name and build commands"; }
add_memory() { backup AGENTS.md; { printf '\n'; cat "$TPL/memory-section.md"; } >> AGENTS.md; }
add_import() { if [ -f CLAUDE.md ]; then backup CLAUDE.md; printf '\n@AGENTS.md\n' >> CLAUDE.md; else printf '@AGENTS.md\n' > CLAUDE.md; fi; }
mk_memfile() { mkdir -p memory; [ -e "$1" ] || cp "$TPL/$1" "$1"; git add -- "$1"; }
if [ ! -f AGENTS.md ]; then fix "no AGENTS.md" "create it from the template" mk_agents
elif grep -q '^## Memory' AGENTS.md; then ok "AGENTS.md has the Memory section"
else fix "AGENTS.md has no Memory section" "append it" add_memory; fi
if [ -f CLAUDE.md ] && grep -q '@AGENTS.md' CLAUDE.md; then ok "CLAUDE.md imports AGENTS.md"
else fix "CLAUDE.md doesn't import AGENTS.md (Claude won't see the rules)" "add '@AGENTS.md'" add_import; fi
for m in memory/progress.md memory/decision.md; do
  if [ ! -f "$m" ]; then fix "no $m" "create and stage it" mk_memfile "$m"
  elif ! git ls-files --error-unmatch "$m" >/dev/null 2>&1; then fix "$m isn't committed" "stage it" mk_memfile "$m"
  else ok "$m tracked"; fi
done
if [ -f memory/progress.md ] && [ "$(wc -l < memory/progress.md)" -gt 150 ]; then
  warn "memory/progress.md is over 150 lines: remove finished items"
fi

echo; echo "── Git hooks (lefthook)"
mk_lefthook() {
  local c fl da cmd
  if [ "$flutter" -eq 1 ]; then
    fl=flutter; da=dart
    if [ -f .fvmrc ]; then fl="fvm flutter"; da="fvm dart"
    else
      note "no .fvmrc: git hooks don't see shell aliases, so give the real commands (or pin first: fvm use <version>)"
      command -v fvm >/dev/null 2>&1 && { fl="fvm flutter"; da="fvm dart"; }
      fl=$(ask_value "Flutter command" "$fl"); da=$(ask_value "Dart command" "$da")
    fi
    c=$(cat "$TPL/lefthook.flutter.yml"); c=${c//@@FLUTTER@@/"$fl"}; c=${c//@@DART@@/"$da"}
  else
    cmd=""; [ -f package.json ] && cmd="npm test"; [ -f go.mod ] && cmd="go test ./..."; [ -f pyproject.toml ] && cmd="pytest"
    cmd=$(ask_value "Test command" "$cmd"); [ -n "$cmd" ] || { note "no test command"; return 1; }
    c=$(cat "$TPL/lefthook.generic.yml"); c=${c//@@TEST@@/"$cmd"}
  fi
  backup lefthook.yml; printf '%s\n' "$c" > lefthook.yml && note "review lefthook.yml, then commit it"
}
has_content() { grep -qvE '^[[:space:]]*(#.*)?$' "$1"; }
if [ ! -f lefthook.yml ]; then fix "no lefthook.yml" "create it from the template" mk_lefthook
elif ! has_content lefthook.yml; then fix "lefthook.yml is only the commented example" "replace it with the template" mk_lefthook; fi
if [ -f lefthook.yml ] && has_content lefthook.yml; then
  chk() { if grep -qiE "$1" lefthook.yml; then ok "lefthook runs $2"; else err "lefthook.yml doesn't run $2"; note "add: $3"; fi; }
  chk 'gitleaks[[:space:]]+(git|dir|protect|detect)' "gitleaks" 'gitleaks git --no-banner --redact --log-opts="HEAD --not --remotes"'
  [ "$flutter" -eq 1 ] && chk 'flutter analyze|dart analyze' "the analyzer" 'fvm flutter analyze --no-pub {push_files}'
  chk '(name:[[:space:]]*[a-z0-9_-]*test|^[[:space:]]+[a-z0-9_-]*test[a-z0-9_-]*:)' "the tests" 'a pre-push job named "test"'
  chk 'code-review|ai-review' "the AI review reminder" 'a pre-push job named "ai-review-reminder" that prints a reminder'
  if grep -q 'ai-setup link' lefthook.yml; then ok "lefthook refreshes the agent guide links"
  else warn "lefthook.yml doesn't refresh the agent guide links"; note "add a pre-push job: command -v ai-setup >/dev/null 2>&1 && ai-setup link --quiet || true"; fi
fi
hooks=$(git rev-parse --git-path hooks); missing=""
for h in pre-commit pre-push commit-msg; do grep -q lefthook "$hooks/$h" 2>/dev/null || missing="$missing $h"; done
inst_hooks() { command -v lefthook >/dev/null 2>&1 || { note "lefthook isn't installed (brew install lefthook)"; return 1; }; lefthook install >/dev/null; }
if [ -z "$missing" ]; then ok "hooks installed"; else fix "hooks not installed:$missing" "run lefthook install" inst_hooks; fi

echo; echo "── Secrets (gitleaks)"
mk_gitleaks() { cp "$TPL/gitleaks.flutter.toml" .gitleaks.toml; }
add_rules()   { backup .gitleaks.toml; cat "$TPL/gitleaks-mobile-rules.toml" >> .gitleaks.toml; }
if [ -f .gitleaks.toml ]; then
  if grep -qE '^[[:space:]]*useDefault[[:space:]]*=[[:space:]]*true' .gitleaks.toml; then ok ".gitleaks.toml keeps the built-in rules"
  else err ".gitleaks.toml drops the built-in rules"; note "add at the top: [extend] + useDefault = true"; fi
fi
if [ "$flutter" -eq 1 ]; then
  if [ ! -f .gitleaks.toml ]; then fix "no .gitleaks.toml (built-in rules miss keystores, signing passwords, Apple keys)" "create it" mk_gitleaks
  elif grep -q 'android-keystore-file' .gitleaks.toml; then ok ".gitleaks.toml has the mobile rules"
  else fix ".gitleaks.toml has no mobile rules" "append them" add_rules; fi
fi
if command -v gitleaks >/dev/null 2>&1; then
  tmp=$(mktemp -d); printf 'token = "ghp_%s"\n' "1a2b3c4d5e6f7g8h9i0jKLMNOPQRSTUVWXyz12" > "$tmp/c.txt"
  cfg=""; [ -f .gitleaks.toml ] && cfg="--config=.gitleaks.toml"
  gitleaks dir --no-banner --log-level error $cfg --report-format json --report-path "$tmp/r.json" "$tmp/c.txt" >/dev/null 2>&1
  grep -q '"RuleID"' "$tmp/r.json" 2>/dev/null && ok "gitleaks catches a planted fake token" || err "gitleaks missed a planted fake token with this config"
  rm -rf "$tmp"
fi

if [ "$flutter" -eq 1 ]; then
  echo; echo "── Static analysis"
  mk_analysis() { cp "$TPL/analysis_options.yaml" analysis_options.yaml; }
  if [ ! -f analysis_options.yaml ]; then fix "no analysis_options.yaml" "create it (flutter_lints + stricter rules)" mk_analysis
  elif grep -qE '^include:[[:space:]]*package:(flutter_lints|lints|very_good_analysis)' analysis_options.yaml; then ok "analysis_options.yaml includes a lint set"
  else warn "analysis_options.yaml doesn't include a lint set (e.g. include: package:flutter_lints/flutter.yaml)"; fi
  grep -qE '^[[:space:]]+(flutter_lints|lints|very_good_analysis):' pubspec.yaml && ok "lint package in pubspec.yaml" \
    || warn "no lint package in pubspec.yaml: fvm flutter pub add --dev flutter_lints"
fi

echo; echo "── Tools (tools.conf: warn only)"
plugin_on() {
  local f
  for f in "$HOME/.claude/settings.json" .claude/settings.json .claude/settings.local.json; do
    [ -f "$f" ] && grep -qE "\"$1(@[^\"]*)?\"[[:space:]]*:[[:space:]]*true" "$f" && return 0
  done; return 1
}
if [ -f "$TOOLS" ]; then
  while read -r level when tool how; do
    case "$level" in ""|\#*) continue ;; esac
    [ "$when" = flutter ] && [ "$flutter" -eq 0 ] && continue
    case "$tool" in plugin:*) plugin_on "${tool#plugin:}" && have=1 || have=0 ;;
                    *) command -v "$tool" >/dev/null 2>&1 && have=1 || have=0 ;; esac
    if [ "$have" -eq 1 ]; then ok "$tool"
    elif [ "$level" = required ]; then warn "missing required tool: $tool  →  $how"
    else warn "recommended: $tool  →  $how"; fi
  done < "$TOOLS"
else warn "no $TOOLS"; fi

echo; echo "── Agent guide links"
link_guides check

[ "$fail" -eq 0 ] && printf '\n\033[1;32mAI setup OK\033[0m\n' || printf '\n\033[1;31mAI setup has problems (see ✗ above)\033[0m\n'
exit "$fail"
